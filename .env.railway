# =============================================================================
# Cartethyia — Railway / Docker environment for the standalone template repo.
#
# WHEN THIS FILE IS USED
#   railway.json can only set build/deploy fields. When the image is built from
#   THIS repository alone (Railway variable wizard, `railway up`,
#   `docker compose`), Railway renders no env vars from a template — the app
#   would crash at boot because CARTETHYIA_ENCRYPTION_KEY and
#   CARTETHYIA_PUBLIC_ORIGIN are required with no defaults.
#
#   So the Dockerfile copies this file into the image as /app/.env.runtime and
#   docker-entrypoint.sh loads it *under* the real environment: any variable
#   already set on the service wins, and the placeholders below are the
#   fallback. In the template-composer flow Railway evaluates the `${{...}}`
#   expressions before the container ever starts.
#
# WHAT YOU MUST DO WHEN DEPLOYING THIS REPO DIRECTLY (not via the template)
#   1. Set CARTETHYIA_ENCRYPTION_KEY  ->  openssl rand -hex 32
#      (any 64 hex chars or base64 of 32 bytes)
#   2. Give the service a public domain — CARTETHYIA_PUBLIC_ORIGIN derives from
#      it automatically through ${{RAILWAY_PUBLIC_DOMAIN}}.
#   A placeholder left in place stops the boot with a clear message instead of
#   starting with a weak key. See DEPLOY.md.
#
# SECURITY
#   This repository is public. Never put real keys in this file: the
#   entrypoint refuses to boot on a placeholder, so a pasted value would only
#   become a published secret. Set secrets as Railway variables.
#
# RELATIONSHIP TO UPSTREAM
#   Upstream's .env.example is the reference for every knob and its default.
#   This file lists only what a hosted, single-container deployment needs.
# =============================================================================

# --- Required (no defaults upstream) ----------------------------------------

# lite = embedded SQLite under /app/data (persisted by the Railway volume).
# full = external PostgreSQL via DATABASE_URL. The template ships lite;
# switching to full later is a backup export + import, not a rebuild.
CARTETHYIA_DB_MODE=lite

# 256-bit key that encrypts provider credentials and API keys.
# Accepts 64 hex chars or base64 of 32 bytes:  openssl rand -hex 32
# ROTATING IT MAKES EVERY STORED CREDENTIAL UNREADABLE.
# The value below is a PLACEHOLDER, not a key. The entrypoint refuses to start
# while a `replace-with-` value is still here; the template supplies a real one.
CARTETHYIA_ENCRYPTION_KEY=replace-with-generated-64-hex-key-77fdd0a82050d7707bbe082682fa364d1d595e0a0394e92fc6924b621ea02e72

# Externally reachable origin for OAuth redirect URIs and console links.
CARTETHYIA_PUBLIC_ORIGIN=https://${{RAILWAY_PUBLIC_DOMAIN}}

# --- Listener ----------------------------------------------------------------

PORT=12800
NODE_ENV=production
LOG_LEVEL=info
DASHBOARD_DIST=/app/dist/dashboard

# --- Persistence (all of this must live on the mounted volume) ---------------

CARTETHYIA_DATA_DIR=/app/data
CARTETHYIA_TELEMETRY_PAYLOAD_DIR=/app/data/telemetry-payloads
CARTETHYIA_INSTALL_ID_DIR=/app/data/.cartethyia
CARTETHYIA_CONFIG_DIR=/app/data/config

# --- Behind the Railway edge -------------------------------------------------

# `platform` is the opt-in mode for a PaaS edge that cannot be allowlisted: the
# edge terminates TLS and every request arrives from the edge, so the client
# address comes from the headers Railway overwrites (CF-Connecting-IP /
# X-Forwarded-For). Do NOT use it if you expose the container directly — a
# caller could then forge its own client address past the per-IP abuse limits.
TRUSTED_PROXY_CIDRS=platform

# Request bodies: 4 MiB admits a ~500K-token context, the upstream ceiling.
# Raise it only with a matching memory bump (worst case is concurrency x this).
# CARTETHYIA_SERVER_MAX_BODY_BYTES=4194304

# --- Optional ----------------------------------------------------------------

# Shared coordination once numReplicas > 1. Unset = in-memory backend, which is
# correct for the default single replica.
# REDIS_URL=${{Redis.REDIS_URL}}

# Unauthenticated rate ceiling per client IP.
# IP_RATE_MAX_PER_WINDOW=240
