{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      "docker-entrypoint.sh",
      ".env.railway",
      ".dockerignore",
      "railway.json",
      "package.json",
      "bun.lock",
      "src/**",
      "dashboard/**",
      "scripts/**",
      "migrations/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "drainingSeconds": 40
  }
}
